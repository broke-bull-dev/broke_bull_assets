# ─── DATABASE ─────────────────────────────────────────────────
# SQLite file — no external server needed
DATABASE_URL="file:./dev.db"

# ─── AUTH ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_secret_here
NEXTAUTH_URL=http://localhost:3000

# Email that gets ADMIN role on registration
ADMIN_EMAIL=your@email.com

# ─── WEB3 ─────────────────────────────────────────────────────
# Alchemy API key — free at https://alchemy.com
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here

# WalletConnect project ID — free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ─── CONTACT ──────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=your@email.com

# ─── EMAIL (optional) ─────────────────────────────────────────
# Resend API key for order email notifications — https://resend.com
# RESEND_API_KEY=your_resend_api_key_here
