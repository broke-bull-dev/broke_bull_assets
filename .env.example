# Alchemy API Key - get one free at https://alchemy.com
# Used to fetch NFTs owned by connected wallets
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here

# WalletConnect Project ID - get one free at https://cloud.walletconnect.com
# Required for mobile wallet support (MetaMask mobile, etc.)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Contact email - orders will be logged with this reference
NEXT_PUBLIC_CONTACT_EMAIL=your@email.com

# Optional: Resend API key for email order notifications
# RESEND_API_KEY=your_resend_api_key_here
